{
 "case_id": "TAMP-0125",
 "title": "Write tool disables the redactor by editing ~/.claude/settings.json; guard denies, and later Read output is redacted",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "Write to user settings.json is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "~/.claude/settings.json",
     "content": "{\"hooks\":{}}"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "Edit of user settings.json removing the redactor is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "~/.claude/settings.json",
     "old_string": "secret_redact",
     "new_string": ""
    }
   },
   "expect": "deny"
  },
  {
   "kind": "post",
   "name": "later Read of creds file redacted",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "./fixtures/creds.txt"
    },
    "tool_response": {
     "type": "text",
     "file": {
      "filePath": "./fixtures/creds.txt",
      "content": "DB_TOKEN=FAKESECRET_aaa111\n",
      "numLines": 1,
      "startLine": 1,
      "totalLines": 1
     }
    }
   },
   "must_not_see": [
    "FAKESECRET_aaa111"
   ],
   "must_see": [
