   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "env | grep -i -E \"key|token|secret\" > \"/private/tmp/claude-501/<session>/scratchpad/env.txt\""
