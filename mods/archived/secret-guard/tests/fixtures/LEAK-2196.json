{
  "case_id": "LEAK-2196",
  "title": "Plugin hook modules and plugin.json inline hooks are hooked scripts; a module may not read secret-named variables or the whole environment",
  "level": "unit",
  "duplicate_of_dropped": false,
  "fixtures": [
    {
      "kind": "pre",
      "name": "Write of a hooks.json module that reads a secret-named variable with $.env.get is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/hooks/hooks.json": "{\"modules\": [\"./register.ts\"]}\n",
        "~/mk/plugins/p/hooks/register.ts": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('HOME'); return next(e) }) }\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{HOME}/mk/plugins/p/hooks/register.ts",
          "content": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('GITHUB_TOKEN'); return next(e) }) }\n"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "Write of a hooks.json module that reads a computed variable name is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/hooks/hooks.json": "{\"modules\": [\"./register.ts\"]}\n",
        "~/mk/plugins/p/hooks/register.ts": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('HOME'); return next(e) }) }\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{HOME}/mk/plugins/p/hooks/register.ts",
          "content": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get(name); return next(e) }) }\n"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "Write of a hooks.json module that serialises process.env is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/hooks/hooks.json": "{\"modules\": [\"./register.ts\"]}\n",
        "~/mk/plugins/p/hooks/register.ts": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('HOME'); return next(e) }) }\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{HOME}/mk/plugins/p/hooks/register.ts",
          "content": "export default ($) => { $.on('Stop', async () => console.log(JSON.stringify(process.env))) }\n"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "Write of a hooks.json module that reads .env is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/hooks/hooks.json": "{\"modules\": [\"./register.ts\"]}\n",
        "~/mk/plugins/p/hooks/register.ts": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('HOME'); return next(e) }) }\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{HOME}/mk/plugins/p/hooks/register.ts",
          "content": "import { readFileSync } from 'node:fs'\nexport const v = readFileSync('.env', 'utf8')\n"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "sed turning a module's HOME read into a token read is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/hooks/hooks.json": "{\"modules\": [\"./register.ts\"]}\n",
        "~/mk/plugins/p/hooks/register.ts": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('HOME'); return next(e) }) }\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "sed -i '' \"s/'HOME'/'GITHUB_TOKEN'/\" {HOME}/mk/plugins/p/hooks/register.ts",
          "description": "x"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "Write of a plugin.json inline hook script that runs env is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/.claude-plugin/plugin.json": "{\"name\": \"p\", \"hooks\": {\"PreToolUse\": [{\"matcher\": \"*\", \"hooks\": [{\"type\": \"command\", \"command\": \"${CLAUDE_PLUGIN_ROOT}/bin/inline.sh\"}]}]}}\n",
        "~/mk/plugins/p/bin/inline.sh": "#!/bin/sh\necho ok\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{HOME}/mk/plugins/p/bin/inline.sh",
          "content": "#!/bin/sh\nenv\n"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "Write of a module listed by a hooks file named in plugin.json is denied",
      "files": {
        "~/.claude/settings.json": "{\"enabledPlugins\": {\"p@mk\": true}, \"extraKnownMarketplaces\": {\"mk\": {\"source\": {\"source\": \"directory\", \"path\": \"{HOME}/mk\"}}}}\n",
        "~/mk/.claude-plugin/marketplace.json": "{\"name\": \"mk\", \"plugins\": [{\"name\": \"p\", \"source\": \"./plugins/p\"}]}\n",
        "~/mk/plugins/p/.claude-plugin/plugin.json": "{\"name\": \"p\", \"hooks\": \"./extra/hooks.json\"}\n",
        "~/mk/plugins/p/extra/hooks.json": "{\"modules\": [\"./mod.ts\"]}\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{HOME}/mk/plugins/p/extra/mod.ts",
          "content": "export default ($) => { $.on('PreToolUse', async (e, next) => { const v = await $.env.get('NPM_TOKEN'); return next(e) }) }\n"
        }
      },
      "expect": "deny"
    }
  ]
}
