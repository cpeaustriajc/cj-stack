{
  "case_id": "FP-0194",
  "title": "Grep count and file lists stay allowed for key names, diff markers, content mode and searches that cannot reach a secret file",
  "level": "unit",
  "duplicate_of_dropped": false,
  "fixtures": [
    {
      "kind": "pre",
      "name": "count of a key name on .env is allowed",
      "files": {
        ".env": "APP_NAME=demo\nSTRIPE_SECRET_KEY=sk_live_FAKESECRETgrep4x7Q2m9Z\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "STRIPE_SECRET_KEY",
          "path": "{PROJECT}/.env",
          "output_mode": "count"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "count of a diff marker on .env is allowed",
      "files": {
        ".env": "APP_NAME=demo\nSTRIPE_SECRET_KEY=sk_live_FAKESECRETgrep4x7Q2m9Z\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "^[-+][^-+]",
          "path": "{PROJECT}/.env",
          "output_mode": "count"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "default file list over a git project whose .env is git-ignored is allowed",
      "files": {
        ".git/HEAD": "ref: refs/heads/main\n",
        ".gitignore": ".env\n",
        ".env": "APP_NAME=demo\nSTRIPE_SECRET_KEY=sk_live_FAKESECRETgrep4x7Q2m9Z\n",
        "src/app.tsx": "useState()\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "useState",
          "path": "{PROJECT}"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "file list restricted to a type that excludes .env is allowed",
      "files": {
        ".env": "APP_NAME=demo\nSTRIPE_SECRET_KEY=sk_live_FAKESECRETgrep4x7Q2m9Z\n",
        "src/app.ts": "useState()\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "useState",
          "path": "{PROJECT}",
          "type": "ts",
          "output_mode": "files_with_matches"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "file list with a glob that excludes .env is allowed",
      "files": {
        ".env": "APP_NAME=demo\nSTRIPE_SECRET_KEY=sk_live_FAKESECRETgrep4x7Q2m9Z\n",
        "src/app.ts": "useState()\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "useState",
          "path": "{PROJECT}",
          "glob": "*.ts",
          "output_mode": "files_with_matches"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "content mode with a value fragment is allowed; the redactor rewrites it",
      "files": {
        ".env": "APP_NAME=demo\nSTRIPE_SECRET_KEY=sk_live_FAKESECRETgrep4x7Q2m9Z\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "sk_live",
          "path": "{PROJECT}",
          "output_mode": "content"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "count over a folder with no secret file is allowed",
      "files": {
        "src/app.ts": "useState()\n"
      },
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Grep",
        "tool_input": {
          "pattern": "useState",
          "path": "{PROJECT}",
          "output_mode": "count"
        }
      },
      "expect": "allow"
    }
  ]
}
