    },
    "tool_response": {
     "stdout": "/srv/app/.env:12:API_KEY=FAKESECRET_a7\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_a7"
   ],
   "must_see": [
    "/srv/app/.env:12:API_KEY="
   ]
  },
