{
 "case_id": "LEAK-1210",
 "title": "recursive grep for KEY/SECRET names over /srv and /etc",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "staging grep over /srv/app and /etc/systemd stays allowed",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "ssh staging 'grep -rn \"API_KEY\\|SECRET\" /srv/app /etc/systemd 2>/dev/null'"
    }
