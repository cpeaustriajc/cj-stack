   },
   "command": "cat git-show-old.out",
   "exit_code": 0,
   "must_not_see": [
    "FAKESECRET_BLOB_01",
    "FAKESECRET_BLOB_02"
   ],
   "must_see": [
    "api_key: [REDACTED]",
    "db_url: postgres://app:[REDACTED]@db/x"
   ]
  }
 ],
 "duplicate_of_dropped": false
}