{
 "case_id": "FP-0073",
 "title": "Short harvested values must not corrupt ordinary output",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "NODE_ENV/PORT values and production-tools path untouched",
   "files": {
    ".env": "NODE_ENV=production\nPORT=3000\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "ps eww -o pid,command -p 4121"
    },
    "tool_response": {
     "stdout": "4121 node server.js NODE_ENV=production PORT=3000 LOG_LEVEL=info\npath /usr/local/lib/production-tools\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [],
   "must_see": [
    "4121 node server.js NODE_ENV=production PORT=3000 LOG_LEVEL=info",
    "path /usr/local/lib/production-tools"
   ]
  },
  {
   "kind": "pre",
   "name": "ps eww for a pid is allowed",
   "files": {
    ".env": "NODE_ENV=production\nPORT=3000\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "ps eww -o pid,command -p 4121"
    }
   },
   "expect": "allow"
  }
 ],
 "duplicate_of_dropped": false
}