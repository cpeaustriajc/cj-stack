{
 "case_id": "LEAK-2008",
 "title": "WireGuard key printed in base64 or hex, so the key-name pattern misses it",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "base64 of a protected wg config is denied",
   "files": {
    "etc/wireguard/wg0.conf": "[Interface]\nPrivateKey = FAKESECRET_WG_PRIV_xxxxxxxxxx=\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "base64 /etc/wireguard/wg0.conf"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "xxd -p of a protected wg config is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "xxd -p /etc/wireguard/wg0.conf"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "od -c of a protected wg config is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "od -c /etc/wireguard/wg0.conf"
    }
   },
   "expect": "deny"
  }
 ],
 "duplicate_of_dropped": false
