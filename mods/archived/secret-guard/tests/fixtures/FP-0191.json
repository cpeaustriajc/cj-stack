{
 "case_id": "FP-0191",
 "title": "Harmless jq and sed edits of settings and hook scripts, and fixed-key compares, are allowed",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "jq merging a permissions default mode is allowed",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"defaultMode\": \"default\"\n  },\n  \"model\": \"opus\",\n  \"enabledPlugins\": {\n    \"secret-guard@cj-stack\": true,\n    \"x@y\": true\n  },\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"npx prettier --check .\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}\n",
    ".claude/hooks/fmt.sh": "#!/bin/sh\nnpx prettier --write \"$1\"\n",
    "~/.claude/statusline.sh": "#!/bin/sh\necho hi\n",
    "payload.txt": "#!/bin/sh\nprintenv\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "jq '.permissions += {\"defaultMode\": \"auto\"}' ~/.claude/settings.json > /tmp/s && mv /tmp/s ~/.claude/settings.json"
    }
   },
   "expect": "allow",
   "policy_note": "owner 2026-10-11: jq and sed edits of Claude Code's config are judged by the file they produce; a compare of a fixed, non-secret key path (with // default, [\"key\"] or tostring) reveals no secret."
  },
  {
   "kind": "pre",
   "name": "jq with_entries turning off another plugin is allowed",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"defaultMode\": \"default\"\n  },\n  \"model\": \"opus\",\n  \"enabledPlugins\": {\n    \"secret-guard@cj-stack\": true,\n    \"x@y\": true\n  },\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"npx prettier --check .\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}\n",
    ".claude/hooks/fmt.sh": "#!/bin/sh\nnpx prettier --write \"$1\"\n",
    "~/.claude/statusline.sh": "#!/bin/sh\necho hi\n",
    "payload.txt": "#!/bin/sh\nprintenv\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "jq '.enabledPlugins |= with_entries(if .key == \"x@y\" then .value = false else . end)' ~/.claude/settings.json > /tmp/s && mv /tmp/s ~/.claude/settings.json"
    }
