    "tool_name": "Bash",
    "tool_input": {
     "command": "cat deploy/.env"
    },
    "tool_response": {
     "stdout": "STRIPE_SECRET_KEY=FAKESECRET_sk_live_abc\nPORT=3000",
     "stderr": "",
     "interrupted": false,
     "isImage": false
    }
   },
   "must_not_see": [
