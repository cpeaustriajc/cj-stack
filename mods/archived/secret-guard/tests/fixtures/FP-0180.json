{
 "case_id": "FP-0180",
 "title": "A plain localhost URL in a .env is not harvested as a secret value",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "dev server log naming the same loopback address as another project's APP_URL",
   "files": {
    "~/Projects/gavel/.env": "APP_NAME=gavel\nAPP_URL=http://127.0.0.1:8000\nDB_HOST=127.0.0.1\nDB_PASSWORD=FAKEpw_Zq8vLm2Rt7Xc\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "tail hugo.log"
    },
    "tool_response": {
     "stdout": "Web Server is available at http://localhost:8765/ (bind address 127.0.0.1)\nPress Ctrl+C to stop\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false
    }
   },
   "must_see": [
    "bind address 127.0.0.1"
   ]
  },
  {
   "kind": "post",
   "name": "the password from that .env is still redacted",
   "files": {
    "~/Projects/gavel/.env": "APP_NAME=gavel\nAPP_URL=http://127.0.0.1:8000\nDB_HOST=127.0.0.1\nDB_PASSWORD=FAKEpw_Zq8vLm2Rt7Xc\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "tail app.log"
    },
    "tool_response": {
     "stdout": "connect 127.0.0.1 with FAKEpw_Zq8vLm2Rt7Xc failed\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false
    }
   },
   "must_not_see": [
    "FAKEpw_Zq8vLm2Rt7Xc"
   ],
   "must_see": [
    "connect 127.0.0.1"
   ]
  }
 ],
 "duplicate_of_dropped": false
}