{
 "case_id": "LEAK-2014",
 "title": "Case-variant Read path bypasses literal deny rule on case-insensitive APFS (gaps.json index 38)",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "case-variant Read of a protected .pem path is denied",
   "files": {
    "config/FAKESECRET_key.pem": "PRIVATE_KEY=FAKESECRET_pemvalue_0001\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "./config/fakesecret_KEY.PEM"
    }
   },
   "expect": "allow",
   "policy_note": "owner policy: plain reads allowed, values redacted (Read tool on a .PEM path is a plain read of a secret file; the owner allows it.)"
  },
  {
   "kind": "post",
   "name": "if read runs, case-variant Read output is redacted by value",
   "files": {
    "config/FAKESECRET_key.pem": "PRIVATE_KEY=FAKESECRET_pemvalue_0001\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "./config/fakesecret_KEY.PEM"
    },
    "tool_response": {
     "type": "text",
     "file": {
      "filePath": "./config/fakesecret_KEY.PEM",
      "content": "PRIVATE_KEY=FAKESECRET_pemvalue_0001\n",
      "numLines": 1,
      "startLine": 1,
      "totalLines": 1
     }
    }
   },
   "must_not_see": [
    "FAKESECRET_pemvalue_0001"
   ],
   "must_see": [
    "[REDACTED]"
   ]
  }
 ],
 "duplicate_of_dropped": false
}