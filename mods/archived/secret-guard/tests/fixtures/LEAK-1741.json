{
 "case_id": "LEAK-1741",
 "title": "git reflog -p piped to head",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre_exec",
   "name": "reflog patch value replaced, reflog ref line kept",
   "files": {
    "git-reflog-p.out": "a1b2c3d HEAD@{0}: reset: moving to HEAD~1\n@@ -1 +1 @@\n-TOKEN=FAKESECRET_RLP_01\n+TOKEN=<rotated>\n"
   },
   "command": "cat git-reflog-p.out",
   "exit_code": 0,
   "must_not_see": [
    "FAKESECRET_RLP_01"
   ],
   "must_see": [
    "a1b2c3d HEAD@{0}: reset: moving to HEAD~1",
    "-TOKEN=[REDACTED]"
   ]
  },
  {
   "kind": "pre",
   "name": "git reflog -p | head -300 stays allowed",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "git reflog -p | head -300"
    }
   },
   "expect": "allow"
  }
 ],
 "duplicate_of_dropped": false
}