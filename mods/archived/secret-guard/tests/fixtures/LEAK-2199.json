{
  "case_id": "LEAK-2199",
  "title": "Running secret_guard.py on a crafted event is denied like the other guard scripts; its answer tests candidate strings",
  "level": "unit",
  "duplicate_of_dropped": false,
  "fixtures": [
    {
      "kind": "pre",
      "name": "echo of an event piped into python3 -I secret_guard.py is denied",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "echo '{\"tool_name\": \"Write\", \"tool_input\": {\"file_path\": \"a.txt\", \"content\": \"candidate\"}}' | python3 -I mods/secret-guard/hooks/secret_guard.py",
          "description": "x"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "python3 secret_guard.py reading an event file is denied",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "python3 -I mods/secret-guard/hooks/secret_guard.py < /tmp/ev.json",
          "description": "x"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "cat of an event into the installed guard is denied",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "cat /tmp/ev.json | python3 ~/.claude/hooks/secret_guard.py",
          "description": "x"
        }
      },
      "expect": "deny"
    }
  ]
}
