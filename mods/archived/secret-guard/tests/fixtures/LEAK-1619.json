{
 "case_id": "LEAK-1619",
 "title": "Grep content mode matches DB_PASSWORD in staging env (plus Glob regression)",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "Grep content line with DB_PASSWORD value",
   "files": {
    "deploy/.env.staging": "DB_PASSWORD=FAKESECRET_grep5\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Grep",
    "tool_input": {
     "pattern": "DB_PASSWORD",
     "path": "deploy",
     "output_mode": "content"
    },
    "tool_response": {
     "mode": "content",
     "numFiles": 0,
     "filenames": [],
     "content": "deploy/.env.staging:1:DB_PASSWORD=FAKESECRET_grep5",
     "numLines": 1,
     "totalLines": 1
    }
   },
   "must_not_see": [
    "FAKESECRET_grep5"
   ],
   "must_see": [
    "deploy/.env.staging:1:DB_PASSWORD=",
    "[REDACTED]"
   ]
  },
  {
   "kind": "post",
   "name": "Glob regression: filename list passes through unchanged",
   "files": {
    "deploy/.env.staging": "DB_PASSWORD=FAKESECRET_grep5\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Glob",
    "tool_input": {
     "pattern": "deploy/**"
    },
    "tool_response": {
     "filenames": [
      "deploy/.env.staging"
     ],
     "durationMs": 3,
     "numFiles": 1,
     "truncated": false,
     "totalMatches": 1,
     "countIsComplete": true
    }
   },
   "must_not_see": [],
   "must_see": [
    "deploy/.env.staging"
   ]
  }
 ],
 "duplicate_of_dropped": false
}