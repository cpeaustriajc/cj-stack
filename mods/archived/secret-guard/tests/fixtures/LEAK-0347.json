{
 "case_id": "LEAK-0347",
 "title": "Read tool on ~/.aws/credentials with only sandbox denyRead configured",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "Read of ~/.aws/credentials is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/Users/testuser/.aws/credentials"
    }
   },
   "expect": "allow",
   "policy_note": "owner policy: plain reads allowed, values redacted (Plain Read of ~/.aws/credentials with nothing combined. Matches the plain-read rule.)"
  },
  {
   "kind": "post",
   "name": "if run, aws_secret_access_key value is redacted",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/Users/testuser/.aws/credentials"
    },
    "tool_response": {
     "type": "text",
     "file": {
      "filePath": "/Users/testuser/.aws/credentials",
      "content": "[default]\naws_secret_access_key = FAKESECRET_AWS\n",
      "numLines": 2,
      "startLine": 1,
      "totalLines": 2
     }
    }
   },
   "must_not_see": [
    "FAKESECRET_AWS"
   ],
   "must_see": [
    "[default]",
    "aws_secret_access_key"
   ]
  }
 ],
 "duplicate_of_dropped": false
}