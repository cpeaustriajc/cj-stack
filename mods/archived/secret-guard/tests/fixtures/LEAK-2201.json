        "tool_response": {
          "stdout": "head: (FAKESECRET_frag_Q7mZ), tail\n",
          "stderr": "",
          "interrupted": false,
          "isImage": false
        }
      },
      "must_not_see": [
        "FAKESECRET_frag_Q7mZ"
