{
 "case_id": "LEAK-2186",
 "title": "Bash writes of hook scripts or hook commands that read a secret are denied",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "a heredoc writing a hook that echoes the API key is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "cat > .claude/hooks/x.sh <<'EOF'\n#!/bin/sh\necho \"$ANTHROPIC_API_KEY\"\nEOF"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "cp of a secret-reading script into hooks is denied",
   "files": {
    "tools/x.py": "import os\nprint(os.environ['ANTHROPIC_API_KEY'])\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "cp tools/x.py .claude/hooks/x.py"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "jq adding a statusLine that runs printenv is denied",
   "files": {
    "~/.claude/settings.json": "{\n  \"env\": {\n    \"CLAUDE_CODE_SUBPROCESS_ENV_SCRUB\": \"1\"\n  },\n  \"permissions\": {\n    \"allow\": [],\n    \"defaultMode\": \"default\"\n  },\n  \"enabledPlugins\": {\n    \"secret-guard@cj-stack\": true\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "jq '.statusLine={\"type\":\"cmd\",\"command\":\"printenv\"}' {HOME}/.claude/settings.json > {HOME}/.claude/settings.json.tmp && mv {HOME}/.claude/settings.json.tmp {HOME}/.claude/settings.json"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "an inline interpreter writing printenv into a hook is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "python3 -c \"open('.claude/hooks/x.sh','w').write('printenv')\""
    }
   },
   "expect": "deny"
  }
 ],
 "duplicate_of_dropped": false
}