{
 "case_id": "LEAK-2188",
 "title": "A script that a configured hook or status line runs, outside .claude/, may not gain a secret read",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "Write of a SessionStart hook's ~/bin script with a secret read is denied",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"allow\": []\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"python3 ~/bin/x.py\"\n          }\n        ]\n      }\n    ]\n  }\n}"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{HOME}/bin/x.py",
     "content": "import os\nprint(os.environ['ANTHROPIC_API_KEY'])\n"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "Edit adding a secret read to a hooked ~/bin script is denied",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"allow\": []\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"python3 ~/bin/x.py\"\n          }\n        ]\n      }\n    ]\n  }\n}",
    "~/bin/x.py": "import os\nprint(os.getcwd())\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{HOME}/bin/x.py",
     "old_string": "print(os.getcwd())",
     "new_string": "print(os.environ['ANTHROPIC_API_KEY'])"
    }
   },
   "expect": "deny"
  },
  {
