    {
      "kind": "pre",
      "name": "deny literal pw in a comment line",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/deny-literal-pw-in-a-com.md",
          "content": "# DB_PASSWORD=FAKESECRET_cm_8Hq\n"
        }
      },
      "expect": "deny"
