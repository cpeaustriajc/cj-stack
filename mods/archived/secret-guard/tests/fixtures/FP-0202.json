{
  "case_id": "FP-0202",
  "title": "Content checks allow date ranges, prose labels, strftime formats, comment prose and concatenated dict values; literals still deny",
  "level": "unit",
  "duplicate_of_dropped": false,
  "fixtures": [
    {
      "kind": "pre",
      "name": "allow changelog date range after digest",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-changelog-date-ran.md",
          "content": "- **Changelog:** Weekly digest 2026-09-07\u20132026-09-14 ([14ad0c08a](https://github.com/o/r/commit/14ad0c08a))\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow to pass label with fixture ids",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-to-pass-label-with.md",
          "content": "- \"GAP assertion\" fixtures requiring an unredacted secret to pass: LEAK-0402, 1341, 1350, 1940, 0973.\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow tests pass label with a word",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-tests-pass-label-w.md",
          "content": "   - If tests pass: Continue\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow strftime in a date substitution",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-strftime-in-a-date.md",
          "content": "timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow strftime in a backtick date",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-strftime-in-a-back.md",
          "content": "timestamp: !`date -u +%Y-%m-%dT%H:%M:%SZ`\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow OAuth note in a shell comment",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-OAuth-note-in-a-sh.md",
          "content": "heygen auth login --oauth # OAuth = free subscription credits; --api-key bills API credits\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow user and pw pair prose",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-user-and-pw-pair-p.md",
          "content": "Report every credential, or a default. In a user:password pair, only the password half counts.\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow python dict concatenation of a literal and calls",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-python-dict-concat.md",
          "content": "cfg = {\"secret\": \"prefix-\" + make_secret(\"x\") + \"-suffix\"}\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow python dict entry concatenating base64 output",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-python-dict-entry-.md",
          "content": "    \"password\": \"pw-\" + base64.b64encode(raw).decode() + \"!\",\n"
        }
      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "allow keyword argument concatenating a call",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/allow-keyword-argument-c.md",
