      },
      "expect": "allow"
    },
    {
      "kind": "pre",
      "name": "deny literal pw after a prose label with digits",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/deny-literal-pw-after-a-.md",
          "content": "If tests pass: FAKESECRET_pw42\n"
        }
      },
      "expect": "deny"
    },
    {
      "kind": "pre",
      "name": "deny python dict concatenation starting with a random literal",
      "files": {},
      "event": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{PROJECT}/notes/deny-python-dict-concate.md",
