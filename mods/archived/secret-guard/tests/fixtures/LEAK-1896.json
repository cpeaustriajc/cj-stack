    "tool_name": "Bash",
    "tool_input": {
     "command": "strings app.plist | grep -i token"
    },
    "tool_response": {
     "stdout": "    <key>apiToken</key>\n    <string>FAKESECRET_\nSPLIT_1</string>\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false
    }
   },
   "must_not_see": [
    "FAKESECRET_\nSPLIT_1"
   ],
   "must_see": [
    "apiToken",
    "<key>"
   ]
  }
 ],
 "duplicate_of_dropped": false
}