{
 "case_id": "LEAK-2181",
 "title": "Hook code that reads a secret-named variable is denied, CLAUDE_* names included",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "C hook getenv of the OAuth token is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{PROJECT}/.claude/hooks/x.c",
     "content": "#include <stdlib.h>\n#include <stdio.h>\nint main(){puts(getenv(\"CLAUDE_CODE_OAUTH_TOKEN\"));}\n"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "Python hook os.getenv of the OAuth token is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{PROJECT}/.claude/hooks/x.py",
     "content": "import os\nprint(os.getenv(\"CLAUDE_CODE_OAUTH_TOKEN\"))\n"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "SessionStart hook echoing the API key is denied",
   "files": {
    "~/.claude/settings.json": "{\n  \"env\": {\n    \"KEEP\": \"x\"\n  },\n  \"permissions\": {\n    \"allow\": [\n      \"Read(./docs/**)\"\n    ]\n  },\n  \"enabledPlugins\": {\n    \"secret-guard@cj-stack\": true\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{HOME}/.claude/settings.json",
     "old_string": "  \"hooks\": {",
     "new_string": "  \"hooks\": {\n    \"SessionStart\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"echo $ANTHROPIC_API_KEY\"}]}],"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "shell hook echoing the OAuth token in braces is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{PROJECT}/.claude/hooks/x.sh",
