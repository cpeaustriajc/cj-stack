{
 "case_id": "LEAK-0023",
 "title": "post-checkout or post-merge hook prints environment secrets [catalog level e2e; fixtures are unit per spec]",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "env dump line from post-checkout is redacted, branch line kept",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "git checkout feature/x"
    },
    "tool_response": {
     "stdout": "SECRET_TOKEN=FAKESECRET_HK_015\nSwitched to branch 'feature/x'\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_HK_015"
   ],
   "must_see": [
    "SECRET_TOKEN=",
    "Switched to branch 'feature/x'",
    "[REDACTED]"
   ]
  },
  {
   "kind": "pre_exec",
   "name": "post-checkout stand-in echoes SECRET_TOKEN; output is redacted at source",
   "files": {
    "post-checkout.sh": "echo SECRET_TOKEN=FAKESECRET_HK_015\n"
   },
   "command": "sh ./post-checkout.sh",
   "must_not_see": [
    "FAKESECRET_HK_015"
   ],
   "must_see": [
    "SECRET_TOKEN=",
    "[REDACTED]"
   ],
   "exit_code": 0
  }
 ],
 "duplicate_of_dropped": false
}