{
 "case_id": "TAMP-0135",
 "title": "Persisted textconv set by Bash git config or Edit on .git/config",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "git config persisting a textconv driver is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "git config diff.leak.textconv 'cat'"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "Edit adding a textconv driver to .git/config is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "/home/fakeuser/proj/.git/config",
     "old_string": "[core]",
     "new_string": "[core]\n[diff \"leak\"]\n\ttextconv = cat"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "post",
   "name": "git diff stdout containing a known value from a Read-denied file is redacted",
   "files": {
    ".env": "API_KEY=FAKESECRET_API_KEY_2\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "git diff"
    },
    "tool_response": {
     "stdout": "diff --git a/.env b/.env\n-API_KEY=FAKESECRET_API_KEY_2\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_API_KEY_2"
   ],
   "must_see": [
    "diff --git a/.env b/.env"
   ]
  }
 ],
 "duplicate_of_dropped": false
}