{
 "case_id": "LEAK-0032",
 "title": "git log -p -S shows historical AWS-style key in diff",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "git log -p diff added AWS key line redacted, headers and context kept",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "git log -p -S 'AKIA' --all"
    },
    "tool_response": {
     "stdout": "commit 4e7a9d1c0b2f3a6e8d5c7b9a1f0e2d3c4b5a6978\n\ndiff --git a/config/aws.env b/config/aws.env\n@@ -1,2 +1,3 @@\n REGION=us-east-1\n+AWS_ACCESS_KEY_ID=AKIAFAKESECRET00000\n SERVICE=api\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "AKIAFAKESECRET00000"
   ],
   "must_see": [
    "4e7a9d1c0b2f3a6e8d5c7b9a1f0e2d3c4b5a6978",
    "diff --git a/config/aws.env b/config/aws.env",
    "@@ -1,2 +1,3 @@",
    "REGION=us-east-1",
    "+AWS_ACCESS_KEY_ID=",
    "SERVICE=api"
   ]
  },
  {
   "kind": "pre_exec",
   "name": "printf simulates git log -p diff line with AKIA-shaped key",
   "files": {},
   "command": "printf 'diff --git a/config/aws.env b/config/aws.env\\n+AWS_ACCESS_KEY_ID=AKIAFAKESECRET00000\\n'",
   "exit_code": 0,
   "must_not_see": [
    "AKIAFAKESECRET00000"
   ],
   "must_see": [
    "diff --git a/config/aws.env b/config/aws.env",
    "+AWS_ACCESS_KEY_ID="
   ]
  }
 ],
 "duplicate_of_dropped": false
}