  {
   "kind": "pre",
   "name": "jq with_entries turning every plugin off is denied",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"defaultMode\": \"default\"\n  },\n  \"model\": \"opus\",\n  \"enabledPlugins\": {\n    \"secret-guard@cj-stack\": true,\n    \"x@y\": true\n  },\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"npx prettier --check .\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}\n",
    ".claude/hooks/fmt.sh": "#!/bin/sh\nnpx prettier --write \"$1\"\n",
    "~/.claude/statusline.sh": "#!/bin/sh\necho hi\n",
    "payload.txt": "#!/bin/sh\nprintenv\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "jq '.enabledPlugins |= with_entries(.value = false)' ~/.claude/settings.json > /tmp/s && mv /tmp/s ~/.claude/settings.json"
    }
