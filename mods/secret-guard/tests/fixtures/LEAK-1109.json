{
 "case_id": "LEAK-1109",
 "title": "Bash cat, head, or less of a dotenv or home credential file",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "cat .env.local is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "cat .env.local"
    }
   },
   "expect": "allow",
   "policy_note": "owner policy: plain reads allowed, values redacted (Plain cat of a named secret file (.env.local), nothing combined.)"
  },
  {
   "kind": "pre",
   "name": "cat ~/.my.cnf is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "cat ~/.my.cnf"
    }
   },
   "expect": "allow",
   "policy_note": "owner policy: plain reads allowed, values redacted (Plain cat of a named secret file (~/.my.cnf), nothing combined.)"
  },
  {
   "kind": "post",
   "name": "if reached, URL userinfo is masked",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_fx_1109a",
    "tool_input": {
     "command": "cat .env"
    },
    "tool_response": {
     "stdout": "DATABASE_URL=postgres://app:FAKESECRET_pw@db/app\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_pw"
   ],
   "must_see": [
    "postgres://app:[REDACTED]@db/app"
   ]
  },
  {
   "kind": "post",
   "name": "if reached, my.cnf password is masked",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_use_id": "toolu_fx_1109b",
    "tool_input": {
     "command": "cat ~/.my.cnf"
    },
    "tool_response": {
     "stdout": "[client]\npassword=FAKESECRET_pw\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_pw"
   ],
   "must_see": [
    "password=[REDACTED]"
   ]
  }
 ],
 "duplicate_of_dropped": false
}