     "content": "threshold_a=FAKESECRET_HARVESTED_0001"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "Edit with harvested .env value is denied",
   "files": {
    ".env": "APP_TOKEN_X=FAKESECRET_HARVESTED_0001\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "w1.txt",
     "old_string": "threshold_a=0",
     "new_string": "threshold_a=FAKESECRET_HARVESTED_0001"
    }
   },
   "expect": "deny"
  },
  {
   "kind": "pre",
   "name": "Benign Write without a harvested value stays allowed",
   "files": {
    ".env": "APP_TOKEN_X=FAKESECRET_HARVESTED_0001\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
