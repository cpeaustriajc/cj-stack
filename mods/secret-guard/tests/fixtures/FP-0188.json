{
 "case_id": "FP-0188",
 "title": "Harmless edits of hooked scripts and any edit of unhooked files outside .claude/ are allowed",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "a harmless Write of a hooked ~/bin script is allowed",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"allow\": []\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"python3 ~/bin/x.py\"\n          }\n        ]\n      }\n    ]\n  }\n}"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{HOME}/bin/x.py",
     "content": "import os\nprint(os.getcwd())\n"
    }
   },
   "expect": "allow",
   "policy_note": "owner 2026-10-11: a script a configured hook or status line runs gets the hook-script content scan wherever it lives; other files are not affected."
  },
  {
   "kind": "pre",
   "name": "a harmless Edit of a hooked ~/bin script is allowed",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"allow\": []\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"python3 ~/bin/x.py\"\n          }\n        ]\n      }\n    ]\n  }\n}",
    "~/bin/x.py": "import os\nprint(os.getcwd())\n"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{HOME}/bin/x.py",
     "old_string": "getcwd",
     "new_string": "getpid"
    }
   },
   "expect": "allow",
   "policy_note": "owner 2026-10-11: a script a configured hook or status line runs gets the hook-script content scan wherever it lives; other files are not affected."
  },
  {
   "kind": "pre",
   "name": "a Write of an unhooked ~/bin file is allowed",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"allow\": []\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"python3 ~/bin/x.py\"\n          }\n        ]\n      }\n    ]\n  }\n}"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{HOME}/bin/other.py",
     "content": "import os\nprint(os.environ['ANTHROPIC_API_KEY'])\n"
    }
   },
   "expect": "allow",
   "policy_note": "owner 2026-10-11: a script a configured hook or status line runs gets the hook-script content scan wherever it lives; other files are not affected."
  },
  {
   "kind": "pre",
   "name": "a heredoc into an unhooked ~/bin file is allowed",
   "files": {
    "~/.claude/settings.json": "{\n  \"permissions\": {\n    \"allow\": []\n  },\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"~/.claude/hooks/secret_redact.py\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"python3 ~/bin/x.py\"\n          }\n        ]\n      }\n    ]\n  }\n}"
   },
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
