 "title": "curl -v echoes Authorization header to stderr",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "curl -v Authorization line on stderr",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "curl -v -H \"Authorization: Bearer $DEPLOY_TOKEN\" https://api.example.com/deploy"
    },
    "tool_response": {
     "stdout": "{\"deployed\":true}\n",
     "stderr": "*   Trying 93.184.216.34:443...\n> Authorization: Bearer FAKESECRET_DEPLOY_01\n> POST /deploy HTTP/2\n",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_DEPLOY_01"
