   "name": "curl -v stderr at source, local script stands in",
   "files": {
    "curl-sim.sh": "export DEPLOY_TOKEN=FAKESECRET_DEPLOY_01\necho \"> Authorization: Bearer $DEPLOY_TOKEN\" >&2\necho '{\"deployed\":true}'\n"
   },
   "command": "sh ./curl-sim.sh",
   "exit_code": 0,
   "must_not_see": [
