{
 "case_id": "LEAK-1997",
 "title": "Keystore password in a fastlane env file surfaced by grep -r",
 "level": "unit",
 "fixtures": [
  {
   "kind": "post",
   "name": "Grep output value redacted, key name kept",
   "files": {
    "fastlane/.env.default": "ANDROID_KEYSTORE_PASSWORD=FAKESECRET_KS_PW_123\n"
   },
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Grep",
    "tool_input": {
     "pattern": "password",
     "output_mode": "content"
    },
    "tool_response": {
     "mode": "content",
     "numFiles": 1,
     "filenames": [
      "fastlane/.env.default"
     ],
     "content": "ANDROID_KEYSTORE_PASSWORD=FAKESECRET_KS_PW_123\n",
     "numLines": 1,
     "totalLines": 1
    }
   },
   "must_not_see": [
    "FAKESECRET_KS_PW_123"
   ],
   "must_see": [
    "ANDROID_KEYSTORE_PASSWORD=[REDACTED]"
   ]
  }
 ],
 "duplicate_of_dropped": false
}