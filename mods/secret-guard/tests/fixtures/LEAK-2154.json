{
 "case_id": "LEAK-2154",
 "title": "Read tool on the systemd credential path bypasses only the Bash guard",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "Read of /run/credentials path is denied",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/run/credentials/app.service/db_pass"
    }
   },
   "expect": "allow",
   "policy_note": "owner policy: plain reads allowed, values redacted (Plain Read of a secret-path file with nothing combined; owner's decision allows Read on secret files.)"
  },
  {
   "kind": "pre",
   "name": "CREDENTIALS_DIRECTORY env var read is not classified as a secret",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "echo \"$CREDENTIALS_DIRECTORY\""
    }
   },
   "expect": "allow"
  },
  {
   "kind": "post",
   "name": "Read output of the credential path is redacted as a fallback",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/run/credentials/app.service/db_pass"
    },
    "tool_response": {
     "type": "text",
     "file": {
      "filePath": "/run/credentials/app.service/db_pass",
      "content": "FAKESECRET_plainpw_9x\n",
      "numLines": 1,
      "startLine": 1,
      "totalLines": 1
     }
    }
   },
   "must_not_see": [
    "FAKESECRET_plainpw_9x"
   ],
   "must_see": [
    "filePath",
    "numLines",
    "[REDACTED]"
   ]
  }
 ],
 "duplicate_of_dropped": false
}