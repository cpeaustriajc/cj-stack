{
 "case_id": "LEAK-1021",
 "title": "env redirected to a file then read back with Read",
 "level": "unit",
 "fixtures": [
  {
   "kind": "pre",
   "name": "env redirected to a temp file is allowed (empty stdout)",
   "files": {},
   "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "env > \"$TMPDIR/debug.txt\""
    }
   },
   "expect": "allow"
  },
  {
   "kind": "post",
   "name": "Read of the redirected dump: value redacted, name kept",
   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/private/tmp/claude-501/debug.txt"
    },
    "tool_response": {
     "type": "text",
     "file": {
      "filePath": "/private/tmp/claude-501/debug.txt",
      "content": "OPENAI_API_KEY=FAKESECRET_oa_AR42\n",
      "numLines": 1,
      "startLine": 1,
      "totalLines": 1
     }
    }
   },
   "must_not_see": [
    "FAKESECRET_oa_AR42"
   ],
   "must_see": [
    "OPENAI_API_KEY=[REDACTED]"
   ]
  }
 ],
 "duplicate_of_dropped": false
}