   "files": {},
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "env | grep -i proxy"
    },
    "tool_response": {
     "stdout": "HTTPS_PROXY=http://FAKEUSER_a:FAKESECRET_proxy1@proxy.example.internal:3128\nNO_PROXY=localhost,127.0.0.1\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false,
     "noOutputExpected": false
    }
   },
   "must_not_see": [
    "FAKESECRET_proxy1"
   ],
   "must_see": [
    "HTTPS_PROXY=http://FAKEUSER_a:[REDACTED]@proxy.example.internal:3128",
    "NO_PROXY=localhost,127.0.0.1"
   ]
  },
