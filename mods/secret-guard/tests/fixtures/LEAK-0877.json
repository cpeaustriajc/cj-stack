    "tool_response": {
     "stdout": "TELEGRAM_API_ID=FAKESECRET_tg_12345\nAPP_PORT=3000\n",
     "stderr": "",
     "interrupted": false,
     "isImage": false
    }
   },
   "must_not_see": [
    "FAKESECRET_tg_12345"
   ],
   "must_see": [
    "APP_PORT=3000",
    "TELEGRAM_API_ID",
