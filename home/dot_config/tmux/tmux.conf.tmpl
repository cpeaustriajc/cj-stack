# ── Core ──────────────────────────────────────────────────────────────────────

set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB,xterm-ghostty:RGB"

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

set -s escape-time 0        # no delay after Esc (critical for nvim)
set -g extended-keys on     # kitty/CSI-u encoding for modifier keys
set -g focus-events on      # nvim autoread on pane focus
set -g mouse on
set -g history-limit 50000
set -g display-time 2000
set -g set-clipboard on

# ── Prefix: Ctrl-Space ────────────────────────────────────────────────────────

unbind C-b
set -g prefix C-Space
bind C-Space send-prefix   # pass through to nested tmux / nvim

# ── Reload ────────────────────────────────────────────────────────────────────

bind r source-file ~/.config/tmux/tmux.conf \; display "tmux.conf reloaded"

# ── Windows & splits ──────────────────────────────────────────────────────────

unbind '"'
unbind %
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# ── Vim-aware pane navigation (no prefix) ────────────────────────────────────
# Passes C-h/j/k/l through to nvim; otherwise selects the adjacent pane.
# Nvim keymaps use the same keys for split navigation — no plugin needed.
# Trade-off: C-l (clear screen) is shadowed when a pane exists to the right.
# Use prefix+L to send a clear to the shell when needed.

is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
  | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"

bind -n C-h if-shell "$is_vim" 'send-keys C-h' 'select-pane -L'
bind -n C-j if-shell "$is_vim" 'send-keys C-j' 'select-pane -D'
bind -n C-k if-shell "$is_vim" 'send-keys C-k' 'select-pane -U'
bind -n C-l if-shell "$is_vim" 'send-keys C-l' 'select-pane -R'

bind L send-keys 'C-l'     # clear screen when C-l is shadowed

# ── Pane resize (repeatable, prefix + H/J/K/L) ───────────────────────────────

bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# ── Window switching without prefix ──────────────────────────────────────────

bind -n M-h previous-window
bind -n M-l next-window
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5

# ── Copy mode (vi keys → system clipboard) ───────────────────────────────────

setw -g mode-keys vi
bind v copy-mode
bind -T copy-mode-vi v   send -X begin-selection
{{ if eq .chezmoi.os "darwin" -}}
bind -T copy-mode-vi y   send -X copy-pipe-and-cancel "pbcopy"
{{- else -}}
bind -T copy-mode-vi y   send -X copy-pipe-and-cancel "xclip -selection clipboard 2>/dev/null || wl-copy"
{{- end }}
bind -T copy-mode-vi Escape send -X cancel

# ── Status bar — Catppuccin (auto dark/light) ─────────────────────────────────

set -g status on
set -g status-interval 5
set -g status-position bottom
set -g status-justify left

{{ if eq .chezmoi.os "darwin" -}}
if-shell "defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark" \
  "source-file ~/.config/tmux/themes/dark.conf" \
  "source-file ~/.config/tmux/themes/light.conf"
{{- else -}}
if-shell "gdbus call --session --dest org.freedesktop.portal.Desktop --object-path /org/freedesktop/portal/desktop --method org.freedesktop.portal.Settings.Read org.freedesktop.appearance color-scheme 2>/dev/null | grep -q 'uint32 1'" \
  "source-file ~/.config/tmux/themes/dark.conf" \
  "source-file ~/.config/tmux/themes/light.conf"
{{- end }}

set -g status-style "bg=#{@bg},fg=#{@fg}"

# Left: session name
set -g status-left-length 30
set -g status-left "#[fg=#{@bg},bg=#{@accent},bold] #S #[fg=#{@accent},bg=#{@bg},nobold]  "

# Right: git branch · date · time
set -g status-right-length 80
set -g status-right \
  "#[fg=#{@muted}]#(cd #{pane_current_path} && git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/.*/ &/')"\
"  #[fg=#{@fg}]%a %b %-d  #[fg=#{@accent},bold]%H:%M "

# Windows
setw -g window-status-format         " #I:#W "
setw -g window-status-current-format "#[fg=#{@bg},bg=#{@accent},bold] #I:#W #[fg=#{@accent},bg=#{@bg},nobold]"
setw -g window-status-style          "fg=#{@muted}"
setw -g window-status-current-style  "fg=#{@accent}"
setw -g window-status-separator      ""

# Pane borders
set -g pane-border-style        "fg=#{@surface}"
set -g pane-active-border-style "fg=#{@accent}"

# Messages
set -g message-style "bg=#{@accent},fg=#{@bg},bold"
