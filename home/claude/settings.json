{
  "cleanupPeriodDays": 7,
  "env": {
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "25"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "mcp__acp__Edit",
      "mcp__acp__Bash",
      "mcp__acp__Write",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(grep:*)",
      "Bash(php artisan test:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(composer lint:*)",
      "Bash(composer test:types)",
      "Bash(php artisan:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npx tsc:*)",
      "mcp__Claude_Preview__preview_start",
      "WebSearch",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(npx biome:*)",
      "Bash(npx vite:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(git log:*)",
      "Bash(tanstack search-docs:*)",
      "Bash(tanstack doc:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(brew list:*)",
      "Read(//tmp/**)",
      "Bash(./node_modules/.bin/biome check *)",
      "Bash(npx vitest *)",
      "Bash(git mv *)",
      "Bash(php -d memory_limit=1G artisan wayfinder:generate --fresh)"
    ],
    "deny": [
      "Read(~/.ssh/**/*.pem)",
      "Read(~/.ssh/**/*.pem.bak)",
      "Read(~/.ssh/**/*.key)",
      "Read(~/.ssh/id_*)",
      "Read(~/Projects/**/.env)",
      "Read(~/Projects/**/.env.local)",
      "Read(~/Projects/**/.env.*.local)",
      "Read(~/Projects/**/.env.production)",
      "Read(~/Projects/**/.env.testing)",
      "Read(~/Projects/**/.dev.vars)",
      "Read(~/Projects/**/.dev.vars.*)",
      "Read(~/Projects/**/prod_dump.sql)",
      "Read(~/Projects/**/*.pem)",
      "Read(~/Projects/**/*.key)",
      "Read(~/Projects/**/*.p8)",
      "Read(~/Projects/**/*.p12)",
      "Read(~/Projects/**/*.pfx)",
      "Read(~/Projects/**/*.ppk)",
      "Read(~/Projects/**/*.jks)",
      "Read(~/Projects/**/*.keystore)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/deny-unprefixed-branch.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deny-migrations.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deny-1m-subagent.sh"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-thread-model.sh"
          }
        ]
      },
      {
        "matcher": "^mcp__.*__save_(issue|comment|project|document|status_update)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deny-linear-engineering-text.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/settings-drift.sh"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/cj/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": false,
    "cloudflare@cloudflare": false,
    "swift-lsp@claude-plugins-official": true,
    "design@cj-stack": true,
    "engineering@cj-stack": true,
    "planning@cj-stack": true,
    "knowledge@cj-stack": true,
    "hyperframes@hyperframes": false,
    "linear-gate@cj-stack": true,
    "frontend-design@anthropic-plugin-directory": true,
    "hone-nudge@cj-stack": true,
    "work-folder@cj-stack": true,
    "session-modes@cj-stack": true,
    "git-guard@cj-stack": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/ChromeDevTools/chrome-devtools-mcp.git"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "cj-stack": {
      "source": {
        "source": "directory",
        "path": "~/Projects/cj-stack"
      }
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low",
      "autoCompactWindow": 400000
    },
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 100000
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "fileCheckpointingEnabled": true,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "disableDeepLinkRegistration": "disable",
  "voiceEnabled": true,
  "autoUpdaterChannel": "latest",
  "planDirectory": "./plans"
}
